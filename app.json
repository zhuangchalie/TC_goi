{
  "expo": {
    "name": "GuardianAI Intel",
    "slug": "guardian-ai-intel",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "guardianai",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.guardianai.intel",
      "permissions": [
        "RECEIVE_SMS",
        "READ_SMS",
        "READ_PHONE_STATE",
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "SEND_SMS",
        "RECORD_AUDIO",
        "READ_MEDIA_AUDIO"
      ],
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "./plugins/withGuardianNative"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}